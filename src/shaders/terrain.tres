code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform float u;
uniform float v;
uniform sampler2D heightmap;
uniform int height;
uniform sampler2D normalmap;
uniform vec4 colour : source_color;
uniform sampler2D grass_texture;
uniform sampler2D sand_texture;
uniform sampler2D dirt_texture;
uniform sampler2D rock_texture;
uniform sampler2D snow_texture;


// GlobalExpression:0
	uniform mat3 u_terrain_normal_basis;
	
	vec3 unpack_normalmap(vec4 rgba){
		vec3 n = rgba.xzy * 2.0 - vec3(1.0);
		n.z *= 1.0;
		return n;
	}

void vertex() {
// Input:4
	vec2 n_out4p0 = UV;


// VectorDecompose:3
	float n_out3p0 = vec3(n_out4p0, 0.0).x;
	float n_out3p1 = vec3(n_out4p0, 0.0).y;
	float n_out3p2 = vec3(n_out4p0, 0.0).z;


// FloatParameter:2
	float n_out2p0 = u;


// FloatOp:6
	float n_out6p0 = n_out3p0 + n_out2p0;


// FloatParameter:5
	float n_out5p0 = v;


// FloatOp:7
	float n_out7p0 = n_out3p1 + n_out5p0;


// VectorCompose:8
	float n_in8p2 = 0.00000;
	vec3 n_out8p0 = vec3(n_out6p0, n_out7p0, n_in8p2);


	vec4 n_out11p0;
// Texture2D:11
	n_out11p0 = texture(heightmap, vec2(n_out8p0.xy));


// IntParameter:19
	int n_out19p0 = height;


// VectorCompose:12
	float n_in12p0 = 0.00000;
	float n_in12p2 = 0.00000;
	vec3 n_out12p0 = vec3(n_in12p0, float(n_out19p0), n_in12p2);


// VectorOp:13
	vec3 n_out13p0 = vec3(n_out11p0.xyz) * n_out12p0;


// Input:14
	vec3 n_out14p0 = VERTEX;


// VectorOp:15
	vec3 n_out15p0 = n_out13p0 + n_out14p0;


	vec3 n_out20p0;
// Expression:20
	n_out20p0 = vec3(0.0, 0.0, 0.0);
	{
		n_out20p0 = u_terrain_normal_basis * unpack_normalmap(texture(normalmap, vec2(n_out8p0.xy)));
	}


// ColorParameter:22
	vec4 n_out22p0 = colour;
	float n_out22p1 = n_out22p0.r;
	float n_out22p2 = n_out22p0.g;
	float n_out22p3 = n_out22p0.b;


// VectorCompose:23
	vec3 n_out23p0 = vec3(n_out22p1, n_out22p2, n_out22p3);


// Output:0
	VERTEX = n_out15p0;
	NORMAL = n_out20p0;
	COLOR.rgb = n_out23p0;


}

void fragment() {
// Input:15
	vec2 n_out15p0 = UV;


	vec4 n_out4p0;
// Texture2D:4
	n_out4p0 = texture(grass_texture, n_out15p0);


	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(sand_texture, n_out15p0);


	vec4 n_out9p0;
// Texture2D:9
	n_out9p0 = texture(dirt_texture, n_out15p0);


	vec4 n_out11p0;
// Texture2D:11
	n_out11p0 = texture(rock_texture, n_out15p0);


	vec4 n_out13p0;
// Texture2D:13
	n_out13p0 = texture(snow_texture, n_out15p0);


	vec3 n_out14p0;
// Expression:14
	n_out14p0 = vec3(0.0, 0.0, 0.0);
	{
		n_out14p0 = n_out4p0.rgb;
	}


// Output:0
	ALBEDO = n_out14p0;


}
"
